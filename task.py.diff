+def _active_publish_module():
+    """
+    Chooses which publisher backend handles cross-posting.
+
+    official_publish (this fork's addition) calls YouTube/TikTok/Instagram's
+    own APIs directly, at zero API cost. upload_post relays through the paid
+    Upload-Post service and stays available as a fallback. Toggle with
+    [app].official_publish_enabled in config.toml.
+    """
+    if config.app.get("official_publish_enabled", False):
+        return official_publish
+    return upload_post
+
